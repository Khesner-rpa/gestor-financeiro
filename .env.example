# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env (ele ja esta no .gitignore).

# URL de conexao com o PostgreSQL (Neon)
DB_URL=jdbc:postgresql://SEU_HOST:5432/SEU_BANCO?sslmode=require

# Usuario do banco
DB_USERNAME=seu_usuario

# Senha do banco
DB_PASSWORD=sua_senha

# Driver JDBC (padrao para PostgreSQL)
DB_DRIVER=org.postgresql.Driver

# Use "true" quando estiver servindo via HTTPS (em producao)
SESSION_COOKIE_SECURE=false